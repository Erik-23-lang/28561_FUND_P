// Localizador de llaves fisicas (Version - Alarma con retraso de tiempo)

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <windows.h> // Necesario para usar la funcion Sleep()

// Funcion compacta para preguntar y guardar en archivo
int preguntar(const char *lugar, FILE *archivo) {
    char resp;
    do {
        printf("Crees que esten en %s? (S/N): ", lugar);
        scanf(" %c", &resp);
    } while (resp != 's' && resp != 'S' && resp != 'n' && resp != 'N');

    if (archivo) fprintf(archivo, "En %s? %c\n", lugar, resp);
    return (resp == 's' || resp == 'S');
}

// Funcion 1: Buscar llaves
void buscar_llaves() {
    system("cls"); // Limpia la pantalla al entrar a la opcion
    system("mkdir Registro_Busqueda 2> nul");
    FILE *archivo = fopen("Registro_Busqueda\\historial.txt", "a");

    const char *lugares[] = {"el bano", "la sala", "el cuarto", "la cocina", "el patio", "el garaje"};
    int encontradas = 0;

    printf("--- BUSCANDO LLAVES ---\n");
    if (archivo) fprintf(archivo, "--- NUEVA BUSQUEDA ---\n");

    for (int i = 0; i < 6; i++) {
        if (preguntar(lugares[i], archivo)) {
            printf("\nPerfecto! Ve a echar un vistazo a %s.\n", lugares[i]);
            encontradas = 1;
            break;
        }
    }

    if (!encontradas) printf("\nNo estan en los lugares tipicos. Sigue buscando!\n");
    if (archivo) fclose(archivo);
}

// Funcion 2: Leer ultimo registro del historial
void ver_historial() {
    system("cls"); // Limpia la pantalla
    FILE *archivo = fopen("Registro_Busqueda\\historial.txt", "r");
    printf("--- ULTIMA BUSQUEDA GUARDADA ---\n\n");

    if (!archivo) {
        printf("Aun no hay registros guardados.\n");
        return;
    }

    char linea[150];
    char ultimo_registro[1000] = "";

    while (fgets(linea, sizeof(linea), archivo)) {
        if (strstr(linea, "--- NUEVA BUSQUEDA ---") != NULL) {
            ultimo_registro[0] = '\0';
        }
        strcat(ultimo_registro, linea);
    }
    fclose(archivo);

    printf("%s", ultimo_registro);
}

// Funcion 3: Mensaje de activacion sonora
void activar_sonido() {
    system("cls");
    printf("--- ALARMA ---\n");
    printf("\nIniciando alarma sonora...\n");

    // Pausa el programa por 5000 milisegundos (5 segundos)
    Sleep(5000);

    printf("La alarma ha finalizado correctamente.\n");
}

int main() {
    int opcion;

    do {
        system("cls"); // Limpia la pantalla cada vez que se muestra el menu
        printf("--- MENU PRINCIPAL ---\n");
        printf("1. Buscar llaves\n");
        printf("2. Ver ultima busqueda\n");
        printf("3. Activar alarma sonora\n");
        printf("4. Salir\n");
        printf("Opcion: ");

        if (scanf("%d", &opcion) != 1) {
            while(getchar() != '\n'); // Limpia si escriben letras
            opcion = 0;
        }

        if (opcion == 1) buscar_llaves();
        else if (opcion == 2) ver_historial();
        else if (opcion == 3) activar_sonido();
        else if (opcion == 4) {
            system("cls");
            printf("\nAdios! Que tengas un buen dia.\n");
            break; // Rompe el ciclo sin hacer pausa
        }
        else {
            printf("\nOpcion no valida.\n");
        }

        // Pausa el programa para que el usuario pueda leer el resultado
        if (opcion >= 1 && opcion <= 3) {
            printf("\n");
            system("pause");
        }

    } while (opcion != 4);

    return 0;
}
