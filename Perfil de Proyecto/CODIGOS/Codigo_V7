#include <stdio.h>
#include <stdlib.h>  // Necesario para system("cls")
#include <windows.h> // Necesario para la alarma (Beep)
#include <time.h>    // Necesario para la fecha

int preguntar(char lugar[], FILE *archivo) {
    char respuesta;
    do {
        printf("¿Crees que esten en %s? (S/N): ", lugar);
        scanf(" %c", &respuesta);

        if (respuesta != 's' && respuesta != 'S' && respuesta != 'n' && respuesta != 'N') {
            printf("  -> Ups, esa letra no es valida. Intenta de nuevo con 'S' (Si) o 'N' (No).\n");
        }
    } while (respuesta != 's' && respuesta != 'S' && respuesta != 'n' && respuesta != 'N');

    // Guardamos en el archivo
    if (archivo != NULL) {
        fprintf(archivo, "¿Crees que esten en %s? (S/N)\n%c\n", lugar, respuesta);
    }

    return (respuesta == 's' || respuesta == 'S');
}

int main() {
    int opcion = 0; 
    char volver;

    do {
        printf("\n--- Menu de Opciones ---\n");
        printf("1. Ayuda para buscar llaves perdidas\n");
        printf("2. Probar el sonido de la alarma\n");
        printf("3. Salir\n");
        printf("Elige una opcion (1, 2 o 3): ");

        if (scanf("%d", &opcion) != 1) {
            while(getchar() != '\n'); 
            opcion = 0;
        }

        if (opcion == 1) {
            printf("\nVamos a buscar tus llaves...\n");

            system("mkdir Registro_Busqueda 2> nul");

            FILE *archivo = fopen("Registro_Busqueda\\historial_preguntas.txt", "a");

            if (archivo != NULL) {
                time_t t = time(NULL);
                struct tm *tm_info = localtime(&t);
                char cadenaFecha[20];

                strftime(cadenaFecha, sizeof(cadenaFecha), "%m/%d/%y", tm_info);
                fprintf(archivo, "\n--- NUEVA CONSULTA: %s ---\n", cadenaFecha);
            } else {
                printf("  -> [Aviso] No se pudo abrir o crear el archivo de registro.\n");
            }

            if (preguntar("el bano", archivo))       { printf("¡Perfecto! Ve a echar un vistazo al bano.\n"); if(archivo) fprintf(archivo, "Resultado: Ir al bano.\n"); }
            else if (preguntar("la sala", archivo))  { printf("¡De acuerdo! Ve a revisar la sala.\n"); if(archivo) fprintf(archivo, "Resultado: Ir a la sala.\n"); }
            else if (preguntar("el dormitorio 1", archivo)) { printf("¡Bien! Busca en el dormitorio 1.\n"); if(archivo) fprintf(archivo, "Resultado: Ir al dormitorio 1.\n"); }
            else if (preguntar("el dormitorio 2", archivo)) { printf("¡Entendido! Revisa el dormitorio 2.\n"); if(archivo) fprintf(archivo, "Resultado: Ir al dormitorio 2.\n"); }
            else if (preguntar("el dormitorio 3", archivo)) { printf("¡Vale! Echa una mirada en el dormitorio 3.\n"); if(archivo) fprintf(archivo, "Resultado: Ir al dormitorio 3.\n"); }
            else if (preguntar("la cocina", archivo))       { printf("¡Genial! Seguro estan en la cocina.\n"); if(archivo) fprintf(archivo, "Resultado: Ir a la cocina.\n"); }
            else if (preguntar("el patio", archivo))        { printf("¡Excelente! Sal a revisar al patio.\n"); if(archivo) fprintf(archivo, "Resultado: Ir al patio.\n"); }
            else if (preguntar("el garaje", archivo))       { printf("¡Muy bien! Toca buscar en el garaje.\n"); if(archivo) fprintf(archivo, "Resultado: Ir al garaje.\n"); }
            else {
                printf("\nVaya, no parece estar en los lugares de siempre. ¡Sigue buscando!\n");
                if(archivo) fprintf(archivo, "Resultado: No se encontraron las llaves.\n");
            }

            if (archivo != NULL) {
                fclose(archivo);
                printf("\n[Sistema] Registro anadido con exito al historial.\n");
            }

            do {
                printf("\n¿Quieres volver al menu de inicio? (S/N): ");
                scanf(" %c", &volver);
            } while (volver != 's' && volver != 'S' && volver != 'n' && volver != 'N');

            if (volver == 'n' || volver == 'N') {
                opcion = 3;
                printf("\nCerrando todo... ¡Nos vemos pronto!\n");
            } else {
                system("cls"); 
            }

        }
        else if (opcion == 2) {
            printf("\nIniciando la alarma...\n");
            for (int i = 0; i < 5; i++) {
                Beep(1200, 300);
                Sleep(100);
                Beep(800, 300);
                Sleep(100);
            }
            printf("Listo, la alarma termino. Te devuelvo al menu.\n");
        }
        else if (opcion == 3) {
            printf("\n¡Que tengas un excelente dia! Adios.\n");
        }
        else {
            printf("\nEse numero no es valido. Por favor, escribe 1, 2 o 3.\n");
        }

    } while (opcion != 3);

    return 0;
}
